{
  "name": "regx",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web"
  ],
  "engines": {
    "node": ">=22.10"
  },
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "abis": "tsx scripts/export-abis.ts",
    "web": "npm run dev -w web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "wc:deploy": "tsx scripts/wc/deploy.ts",
    "wc:note": "tsx scripts/wc/deploy.ts --note",
    "wc:sync": "tsx scripts/wc/sync-assets.ts",
    "wc:keeper": "tsx scripts/wc/keeper.ts",
    "wc:life": "tsx scripts/wc/lifecycle.ts",
    "wc:seed": "tsx scripts/wc/seed-orders.ts",
    "hedera:deploy": "tsx scripts/hedera/deploy.ts",
    "hedera:verify": "tsx scripts/hedera/verify.ts",
    "hedera:sync-assets": "tsx scripts/hedera/arkiv-sync-assets.ts",
    "hedera:seed-orders": "tsx scripts/hedera/seed-orders.ts",
    "hedera:keeper": "tsx scripts/hedera/keeper.ts",
    "hedera:lifecycle": "tsx scripts/hedera/lifecycle.ts",
    "hedera:status": "tsx scripts/hedera/status.ts",
    "hedera:e2e": "tsx scripts/hedera/e2e.ts",
    "hedera:readme": "tsx scripts/hedera/readme.ts",
    "wc:verify": "tsx scripts/wc/verify.ts",
    "wc:e2e": "tsx scripts/wc/e2e.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hiero-ledger/sdk": "^2.90.1",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}